{% extends "layouts/main.html.twig" %}

{% block title %}Nueva Orden de Servicio{% endblock %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-3">
  <div>
    <h2 class="fw-bold mb-1"><i class="bi bi-plus-circle text-primary me-2"></i>Nueva Orden de Servicio</h2>
  </div>
  <a href="{{ base_url }}/operations" class="btn btn-outline-secondary fw-bold">
    <i class="bi bi-arrow-left me-2"></i> Volver a Órdenes
  </a>
</div>

{% if clients|length == 0 or devices|length == 0 %}
  <div class="alert alert-warning d-flex align-items-start" role="alert">
    <i class="bi bi-exclamation-triangle-fill fs-4 me-3"></i>
    <div>
      <strong>Falta información para abrir una orden.</strong>
      <p class="mb-0 small">
        Registre primero
        {% if clients|length == 0 %}<a href="{{ base_url }}/contact/new" class="fw-bold">un cliente</a>{% endif %}
        {% if clients|length == 0 and devices|length == 0 %} y {% endif %}
        {% if devices|length == 0 %}<a href="{{ base_url }}/device/new" class="fw-bold">un dispositivo</a>{% endif %}.
      </p>
    </div>
  </div>
{% endif %}

<div class="card border-0 shadow-sm rounded-3">
  <div class="card-body p-4">
    <form action="{{ base_url }}/operation/create" method="POST">
      {{ csrf_field() }}
      <div class="row g-4">
        <div class="col-md-6 mb-2">
          <label for="contact_id" class="form-label fw-bold">Cliente *</label>
          <select name="contact_id" id="contact_id" class="form-select select2" required>
            <option value="">-- SELECCIONE CLIENTE --</option>
            {% for c in clients %}
              <option value="{{ c.id }}">{{ c.name }} {{ c.lastname }} ({{ c.company|default('Particular') }})</option>
            {% endfor %}
          </select>
        </div>

        <div class="col-md-6 mb-2">
          <label for="device_id" class="form-label fw-bold">Dispositivo / Equipo *</label>
          <select name="device_id" id="device_id" class="form-select select2" required>
            <option value="">-- SELECCIONE DISPOSITIVO --</option>
            {% for d in devices %}
              <option value="{{ d.id }}" data-contact="{{ d.contact_id }}">
                {{ d.plate }} - {{ d.brand }} {{ d.model }}{% if d.getContact() %} ({{ d.getContact().name }} {{ d.getContact().lastname }}){% endif %}
              </option>
            {% endfor %}
          </select>
        </div>

        <div class="col-md-4 mb-2">
          <label for="status_id" class="form-label fw-bold">Estado inicial de recepción *</label>
          <select name="status_id" class="form-select select2" required>
            {% for st in statuses %}
              <option value="{{ st.id }}">{{ st.name }}</option>
            {% endfor %}
          </select>
        </div>

        <div class="col-md-4 mb-2">
          <label for="start_date" class="form-label fw-bold">Fecha de Ingreso</label>
          <input type="date" name="start_date" class="form-control" value="{{ "now"|date("Y-m-d") }}">
        </div>

        <div class="col-md-4 mb-2">
          <label for="end_date" class="form-label fw-bold">Promesa de Entrega</label>
          <input type="date" name="end_date" class="form-control">
        </div>

        <div class="col-md-12 mb-2">
          <label for="description" class="form-label fw-bold">Diagnóstico preliminar / Observaciones *</label>
          <input type="text" name="description" class="form-control" placeholder="Ej. No enciende, se sospecha falla en la fuente de poder..." required>
        </div>
      </div>

      <p class="text-muted small mt-2">* Campos obligatorios</p>
      <div class="mt-4 text-end border-top pt-3">
        <button type="submit" class="btn btn-info text-white fw-bold px-4">
          <i class="bi bi-check-lg me-1"></i> Crear Orden de Servicio
        </button>
        <a href="{{ base_url }}/operations" class="btn btn-secondary px-4 ms-2">Cancelar</a>
      </div>
    </form>
  </div>
</div>

<script type="text/javascript">
  // Al elegir cliente, deja visibles solo sus dispositivos.
  $(document).ready(function(){
    $("#contact_id").change(function(){
      var contactId = $(this).val();
      var $device = $("#device_id");

      $device.find("option").each(function(){
        var owner = $(this).data("contact");
        if (!$(this).val()) return;
        $(this).prop("disabled", contactId !== "" && String(owner) !== String(contactId));
      });

      var $selected = $device.find("option:selected");
      if ($selected.prop("disabled")) {
        $device.val("");
      }
      $device.trigger("change.select2");
    });
  });
</script>
{% endblock %}
