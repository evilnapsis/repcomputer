{% extends "layouts/main.html.twig" %}

{% block title %}Orden #{{ operation.id }}{% endblock %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h2 class="fw-bold mb-1">
      <i class="bi bi-card-checklist text-primary me-2"></i>Orden de Servicio #{{ "%05d"|format(operation.id) }}
      {% if payment_summary.status == 'paid' %}
        <span class="badge bg-success align-middle fs-6">Pagada</span>
      {% elseif payment_summary.status == 'partial' %}
        <span class="badge bg-warning text-dark align-middle fs-6">Abonada &middot; saldo ${{ payment_summary.balance|number_format(2, '.', ',') }}</span>
      {% else %}
        <span class="badge bg-danger align-middle fs-6">Sin pagos</span>
      {% endif %}
    </h2>
  </div>
  <div>
    <a href="report/order-pdf.php?id={{ operation.id }}" target="_blank" class="btn btn-outline-danger fw-bold me-2">
      <i class="bi bi-file-earmark-pdf me-1"></i> Imprimir Orden (PDF)
    </a>
    <a href="{{ base_url }}/operation/{{ operation.id }}/edit" class="btn btn-warning text-white fw-bold me-2">
      <i class="bi bi-pencil-square me-1"></i> Editar Datos
    </a>
    <a href="{{ base_url }}/operations" class="btn btn-outline-dark fw-bold">
      <i class="bi bi-arrow-left me-1"></i> Volver a Órdenes
    </a>
  </div>
</div>

<div class="row g-4">
  <!-- INFORMACIÓN Y CONTROL DE ESTADO -->
  <div class="col-md-4">
    <div class="card border-0 shadow-sm mb-4 rounded-3">
      <div class="card-header bg-dark text-white fw-bold py-3">
        <i class="bi bi-info-circle me-2"></i> Información General
      </div>
      <div class="card-body p-4">
        <div class="d-flex align-items-center mb-3">
          <div class="bg-primary text-white rounded p-3 me-3">
            <i class="bi bi-laptop fs-2"></i>
          </div>
          <div>
            <h5 class="mb-0 fw-bold">{{ operation.getDevice().plate|default('Sin Dispositivo') }}</h5>
            {% if operation.getDevice() %}
              <small class="text-muted d-block">{{ operation.getDevice().brand }} {{ operation.getDevice().model }} (S/N: {{ operation.getDevice().vin|default('N/A') }})</small>
            {% endif %}
          </div>
        </div>
        <hr>
        <div class="mb-3">
          <label class="small text-muted d-block fw-bold">Cliente</label>
          <span class="fw-bold">{{ operation.getContact() ? operation.getContact().name ~ " " ~ operation.getContact().lastname : "Sin contacto" }}</span>
          {% if operation.getContact() %}
            <small class="d-block text-muted"><i class="bi bi-telephone me-1"></i> {{ operation.getContact().phone }}</small>
          {% endif %}
        </div>
        <div class="mb-3">
          <label class="small text-muted d-block fw-bold">Fechas</label>
          <small class="d-block text-secondary">
            <strong>Ingreso:</strong> {{ operation.start_date|default('No definido') }}<br>
            <strong>Entrega:</strong> {{ operation.end_date|default('No definida') }}
          </small>
        </div>
        <div class="mb-0">
          <label class="small text-muted d-block fw-bold">Notas de Entrada</label>
          <p class="small mb-0 text-secondary">{{ operation.description }}</p>
        </div>
      </div>
    </div>

    <div class="card border-0 shadow-sm rounded-3">
      <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
        <span class="fw-bold"><i class="bi bi-hdd-stack me-2 text-primary"></i> Control de Estado</span>
        {% if operation.getStatus() %}
          <span class="badge shadow-sm" style="background-color: {{ operation.getStatus().color }}; color: #fff;">{{ operation.getStatus().name }}</span>
        {% endif %}
      </div>
      <div class="card-body p-4">
        <form method="POST" action="{{ base_url }}/operation/{{ operation.id }}/status-update">
          {{ csrf_field() }}
          <label class="form-label small fw-bold">Cambiar Estado</label>
          <select name="status_id" class="form-select form-select-sm mb-3">
            {% for s in statuses %}
              <option value="{{ s.id }}" {% if operation.status_id == s.id %}selected{% endif %}>{{ s.name }}</option>
            {% endfor %}
          </select>
          <button type="submit" class="btn btn-primary btn-sm w-100 fw-bold">Actualizar Estado</button>
        </form>
      </div>
    </div>
  </div>

  <!-- SERVICIOS DE LA ORDEN -->
  <div class="col-md-8">
    <div class="card border-0 shadow-sm rounded-3">
      <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
        <span class="fw-bold"><i class="bi bi-briefcase me-2 text-primary"></i> Servicios de la Orden</span>
        <button type="button" class="btn btn-dark btn-sm fw-bold" data-coreui-toggle="modal" data-coreui-target="#modalAddDetail">
          <i class="bi bi-plus-lg me-1"></i> Agregar Servicio
        </button>
      </div>
      <div class="card-body p-4">
        <div class="table-responsive">
          <table class="table table-hover align-middle no-datatable">
            <thead class="bg-light">
              <tr>
                <th>Servicio</th>
                <th>Cant.</th>
                <th>P. Unitario</th>
                <th>Subtotal</th>
                <th class="text-end">Acción</th>
              </tr>
            </thead>
            <tbody>
              {% for d in details %}
                <tr>
                  <td class="fw-bold">{{ d.getService() ? d.getService().name : '-' }}</td>
                  <td>{{ d.quantity }}</td>
                  <td>${{ d.price|number_format(2, '.', ',') }}</td>
                  <td class="fw-bold text-success">${{ (d.price * d.quantity)|number_format(2, '.', ',') }}</td>
                  <td class="text-end">
                    <form action="{{ base_url }}/operation/{{ operation.id }}/delete-detail/{{ d.id }}" method="POST" class="d-inline" onsubmit="return confirm('¿Eliminar este servicio?');">
                      {{ csrf_field() }}
                      <button type="submit" class="btn btn-danger btn-sm" title="Eliminar"><i class="bi bi-trash"></i></button>
                    </form>
                  </td>
                </tr>
              {% else %}
                <tr>
                  <td colspan="5" class="text-center py-4 text-muted">No se han registrado servicios en esta orden.</td>
                </tr>
              {% endfor %}
            </tbody>
            {% if details|length > 0 %}
              <tfoot class="table-light">
                <tr>
                  <td colspan="3" class="text-end fw-bold">TOTAL ORDEN:</td>
                  <td class="fw-bold text-success fs-5">${{ operation.total|number_format(2, '.', ',') }}</td>
                  <td></td>
                </tr>
              </tfoot>
            {% endif %}
          </table>
        </div>
      </div>
    </div>

    <!-- COBROS Y ABONOS -->
    <div class="card border-0 shadow-sm rounded-3 mt-4">
      <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
        <span class="fw-bold"><i class="bi bi-cash-coin me-2 text-success"></i> Cobros y Abonos</span>
        {% if payment_summary.balance > 0 %}
          <button type="button" class="btn btn-success btn-sm fw-bold" data-coreui-toggle="modal" data-coreui-target="#modalAddPayment">
            <i class="bi bi-plus-lg me-1"></i> Registrar Pago
          </button>
        {% elseif payment_summary.total > 0 %}
          <span class="badge bg-success">Orden liquidada</span>
        {% endif %}
      </div>
      <div class="card-body p-4">
        <div class="row g-3 mb-4">
          <div class="col-md-4">
            <div class="border rounded-3 p-3 text-center h-100">
              <div class="small text-muted fw-bold">TOTAL ORDEN</div>
              <div class="fs-5 fw-bold">${{ payment_summary.total|number_format(2, '.', ',') }}</div>
            </div>
          </div>
          <div class="col-md-4">
            <div class="border rounded-3 p-3 text-center h-100">
              <div class="small text-muted fw-bold">COBRADO</div>
              <div class="fs-5 fw-bold text-success">${{ payment_summary.paid|number_format(2, '.', ',') }}</div>
            </div>
          </div>
          <div class="col-md-4">
            <div class="border rounded-3 p-3 text-center h-100">
              <div class="small text-muted fw-bold">SALDO PENDIENTE</div>
              <div class="fs-5 fw-bold {% if payment_summary.balance > 0 %}text-danger{% else %}text-success{% endif %}">${{ payment_summary.balance|number_format(2, '.', ',') }}</div>
            </div>
          </div>
        </div>

        {% if payment_summary.overpaid > 0 %}
          <div class="alert alert-warning py-2 small">
            <i class="bi bi-exclamation-triangle me-1"></i>
            Los pagos superan por <strong>${{ payment_summary.overpaid|number_format(2, '.', ',') }}</strong> el total de la orden. Revise los abonos o el detalle de servicios.
          </div>
        {% endif %}

        {% if payment_summary.total <= 0 %}
          <div class="alert alert-info py-2 small mb-0">
            <i class="bi bi-info-circle me-1"></i>
            Agregue primero los servicios de la orden para poder registrar cobros.
          </div>
        {% else %}
          <div class="table-responsive">
            <table class="table table-hover align-middle no-datatable mb-0">
              <thead class="bg-light">
                <tr>
                  <th>Fecha</th>
                  <th>Forma de Pago</th>
                  <th>Referencia</th>
                  <th>Registró</th>
                  <th class="text-end">Monto</th>
                  <th class="text-end">Acción</th>
                </tr>
              </thead>
              <tbody>
                {% for pay in payments %}
                  <tr>
                    <td><small>{{ pay.created_at|date("d/m/Y H:i") }}</small></td>
                    <td><span class="badge bg-secondary">{{ pay.method }}</span></td>
                    <td>
                      {% if pay.reference %}
                        <small>{{ pay.reference }}</small>
                      {% else %}
                        <small class="text-muted">-</small>
                      {% endif %}
                      {% if pay.notes %}
                        <small class="d-block text-muted">{{ pay.notes }}</small>
                      {% endif %}
                    </td>
                    <td><small class="text-muted">{{ pay.getUser() ? pay.getUser().name ~ " " ~ pay.getUser().lastname : '-' }}</small></td>
                    <td class="text-end fw-bold text-success">${{ pay.amount|number_format(2, '.', ',') }}</td>
                    <td class="text-end">
                      <form action="{{ base_url }}/operation/{{ operation.id }}/delete-payment/{{ pay.id }}" method="POST" class="d-inline" onsubmit="return confirm('¿Eliminar este pago de la orden?');">
                        {{ csrf_field() }}
                        <button type="submit" class="btn btn-outline-danger btn-sm" title="Eliminar pago"><i class="bi bi-trash"></i></button>
                      </form>
                    </td>
                  </tr>
                {% else %}
                  <tr>
                    <td colspan="6" class="text-center py-4 text-muted">Aún no se ha registrado ningún pago.</td>
                  </tr>
                {% endfor %}
              </tbody>
              {% if payments|length > 0 %}
                <tfoot class="table-light">
                  <tr>
                    <td colspan="4" class="text-end fw-bold">TOTAL COBRADO:</td>
                    <td class="text-end fw-bold text-success fs-5">${{ payment_summary.paid|number_format(2, '.', ',') }}</td>
                    <td></td>
                  </tr>
                </tfoot>
              {% endif %}
            </table>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</div>

<!-- Modal: registrar un pago o abono -->
<div class="modal fade" id="modalAddPayment" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content text-start">
      <form method="POST" action="{{ base_url }}/operation/{{ operation.id }}/add-payment">
        {{ csrf_field() }}
        <div class="modal-header bg-success text-white">
          <h5 class="modal-title fw-bold"><i class="bi bi-cash-coin me-2"></i>Registrar Pago</h5>
          <button type="button" class="btn-close btn-close-white" data-coreui-dismiss="modal"></button>
        </div>
        <div class="modal-body p-4">
          <div class="alert alert-light border small">
            Total de la orden: <strong>${{ payment_summary.total|number_format(2, '.', ',') }}</strong><br>
            Cobrado: <strong class="text-success">${{ payment_summary.paid|number_format(2, '.', ',') }}</strong><br>
            Saldo pendiente: <strong class="text-danger">${{ payment_summary.balance|number_format(2, '.', ',') }}</strong>
          </div>
          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label fw-bold">Monto a cobrar *</label>
              <input type="number" step="0.01" min="0.01" max="{{ payment_summary.balance }}" name="amount" class="form-control" value="{{ payment_summary.balance }}" required>
              <small class="text-muted">Deje el monto completo para liquidar, o bájelo para registrar un abono.</small>
            </div>
            <div class="col-md-6">
              <label class="form-label fw-bold">Forma de Pago *</label>
              <select name="method" class="form-select" required>
                {% for m in payment_methods %}
                  <option value="{{ m }}">{{ m }}</option>
                {% endfor %}
              </select>
            </div>
            <div class="col-md-12">
              <label class="form-label fw-bold">Referencia</label>
              <input type="text" name="reference" class="form-control" maxlength="100" placeholder="Folio de voucher, transferencia, etc.">
            </div>
            <div class="col-md-12">
              <label class="form-label fw-bold">Observaciones</label>
              <input type="text" name="notes" class="form-control" maxlength="255" placeholder="Opcional">
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-coreui-dismiss="modal">Cancelar</button>
          <button type="submit" class="btn btn-success fw-bold">Registrar Pago</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Modal: agregar servicio a la orden -->
<div class="modal fade" id="modalAddDetail" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content text-start">
      <form method="POST" action="{{ base_url }}/operation/{{ operation.id }}/add-detail">
        {{ csrf_field() }}
        <div class="modal-header bg-dark text-white">
          <h5 class="modal-title fw-bold"><i class="bi bi-briefcase me-2"></i>Agregar Servicio</h5>
          <button type="button" class="btn-close btn-close-white" data-coreui-dismiss="modal"></button>
        </div>
        <div class="modal-body p-4">
          <div class="mb-3">
            <label class="form-label fw-bold">Servicio *</label>
            <select name="service_id" id="service_id_select" class="form-select" required>
              <option value="">-- SELECCIONE SERVICIO --</option>
              {% for s in services %}
                <option value="{{ s.id }}" data-price="{{ s.price }}">{{ s.name }} (${{ s.price|number_format(2, '.', ',') }})</option>
              {% endfor %}
            </select>
            {% if services|length == 0 %}
              <small class="text-muted">No hay servicios en el catálogo. <a href="{{ base_url }}/service/new">Agregue uno primero</a>.</small>
            {% endif %}
          </div>
          <div class="row g-3">
            <div class="col-md-4">
              <label class="form-label fw-bold">Cantidad *</label>
              <input type="number" name="quantity" class="form-control" value="1" min="1" required>
            </div>
            <div class="col-md-4">
              <label class="form-label fw-bold">Precio Unitario *</label>
              <input type="number" step="0.01" name="price" id="detail_price" class="form-control" value="0" required>
            </div>
            <div class="col-md-4">
              <label class="form-label fw-bold">Descuento</label>
              <input type="number" step="0.01" name="discount" class="form-control" value="0">
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-coreui-dismiss="modal">Cancelar</button>
          <button type="submit" class="btn btn-primary fw-bold">Agregar a la Orden</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script type="text/javascript">
  // Al elegir servicio, precarga su precio de catalogo.
  $(document).ready(function(){
    $("#service_id_select").change(function(){
      var price = $(this).find("option:selected").data("price");
      if (price !== undefined) {
        $("#detail_price").val(price);
      }
    });
  });
</script>
{% endblock %}
