{% extends "layouts/main.html.twig" %}

{% block title %}Dashboard{% endblock %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
  <div>
    <h2 class="fw-bold mb-1"><i class="bi bi-speedometer2 me-2" style="color: #15803d;"></i>Panel Principal del Taller</h2>
  </div>
  <a href="{{ base_url }}/operation/new" class="btn btn-primary btn-lg shadow-sm fw-bold">
    <i class="bi bi-plus-circle me-2"></i> Nueva Orden de Servicio
  </a>
</div>

<!-- 6 Cards Contadoras (KPIs) en Colores Crema con Iconos Grandes -->
<div class="row g-3 mb-4">
  <!-- Card 1: Órdenes Activas -->
  <div class="col-sm-6 col-md-4 col-xl-2">
    <a href="{{ base_url }}/operations" class="text-decoration-none">
      <div class="card card-crema card-hover h-100">
        <div class="card-body p-3">
          <div class="d-flex align-items-center justify-content-between">
            <div>
              <div class="widget-title">Órdenes Activas</div>
              <div class="widget-value">{{ active_operations }}</div>
            </div>
            <div class="widget-icon-box" style="background-color: #e8ecf8 !important;">
              <i class="bi bi-tools" style="color: #3b82f6 !important;"></i>
            </div>
          </div>
        </div>
      </div>
    </a>
  </div>

  <!-- Card 2: Órdenes Terminadas -->
  <div class="col-sm-6 col-md-4 col-xl-2">
    <a href="{{ base_url }}/operations" class="text-decoration-none">
      <div class="card card-crema card-hover h-100">
        <div class="card-body p-3">
          <div class="d-flex align-items-center justify-content-between">
            <div>
              <div class="widget-title">Terminadas</div>
              <div class="widget-value">{{ completed_operations }}</div>
            </div>
            <div class="widget-icon-box" style="background-color: #e2f4ea !important;">
              <i class="bi bi-check2-circle" style="color: #15803d !important;"></i>
            </div>
          </div>
        </div>
      </div>
    </a>
  </div>

  <!-- Card 3: Dispositivos -->
  <div class="col-sm-6 col-md-4 col-xl-2">
    <a href="{{ base_url }}/devices" class="text-decoration-none">
      <div class="card card-crema card-hover h-100">
        <div class="card-body p-3">
          <div class="d-flex align-items-center justify-content-between">
            <div>
              <div class="widget-title">Dispositivos</div>
              <div class="widget-value">{{ total_devices }}</div>
            </div>
            <div class="widget-icon-box" style="background-color: #e0f2fe !important;">
              <i class="bi bi-laptop" style="color: #0284c7 !important;"></i>
            </div>
          </div>
        </div>
      </div>
    </a>
  </div>

  <!-- Card 4: Clientes -->
  <div class="col-sm-6 col-md-4 col-xl-2">
    <a href="{{ base_url }}/contacts" class="text-decoration-none">
      <div class="card card-crema card-hover h-100">
        <div class="card-body p-3">
          <div class="d-flex align-items-center justify-content-between">
            <div>
              <div class="widget-title">Clientes</div>
              <div class="widget-value">{{ total_clients }}</div>
            </div>
            <div class="widget-icon-box" style="background-color: #f3e8ff !important;">
              <i class="bi bi-people" style="color: #7c3aed !important;"></i>
            </div>
          </div>
        </div>
      </div>
    </a>
  </div>

  <!-- Card 5: Servicios (Catálogo) -->
  <div class="col-sm-6 col-md-4 col-xl-2">
    <a href="{{ base_url }}/services" class="text-decoration-none">
      <div class="card card-crema card-hover h-100">
        <div class="card-body p-3">
          <div class="d-flex align-items-center justify-content-between">
            <div>
              <div class="widget-title">Servicios</div>
              <div class="widget-value">{{ total_services }}</div>
            </div>
            <div class="widget-icon-box" style="background-color: #fef3c7 !important;">
              <i class="bi bi-briefcase" style="color: #d97706 !important;"></i>
            </div>
          </div>
        </div>
      </div>
    </a>
  </div>

  <!-- Card 6: Usuarios -->
  <div class="col-sm-6 col-md-4 col-xl-2">
    <a href="{{ base_url }}/users" class="text-decoration-none">
      <div class="card card-crema card-hover h-100">
        <div class="card-body p-3">
          <div class="d-flex align-items-center justify-content-between">
            <div>
              <div class="widget-title">Usuarios</div>
              <div class="widget-value">{{ total_users }}</div>
            </div>
            <div class="widget-icon-box" style="background-color: #fae8ff !important;">
              <i class="bi bi-person-badge" style="color: #a21caf !important;"></i>
            </div>
          </div>
        </div>
      </div>
    </a>
  </div>
</div>

<!-- Fila de Gráficas: Pagos (col-md-9) y Estado de Órdenes Pie (col-md-3) -->
<div class="row g-4 mb-4">
  <!-- Gráfica de Pagos de los Últimos 30 Días (col-md-9) -->
  <div class="col-12 col-md-9">
    <div class="card border-0 shadow-sm rounded-3 h-100">
      <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div>
          <h5 class="mb-0 fw-bold">
            <i class="bi bi-graph-up-arrow me-2" style="color: #15803d;"></i>Ingresos por Pagos (Últimos 30 Días)
          </h5>
        </div>
        <a href="{{ base_url }}/reports?opt=payments" class="btn btn-sm btn-outline-secondary">
          <i class="bi bi-file-earmark-text me-1"></i> Ver Reporte Detallado
        </a>
      </div>
      <div class="card-body p-3 p-md-4">
        <!-- Canvas para Chart.js -->
        <div style="position: relative; height: 260px; width: 100%;">
          <canvas id="payments30DaysChart"></canvas>
        </div>

        <!-- Totales abajo de la gráfica -->
        <div class="row g-3 mt-3 pt-3 border-top">
          <!-- Total pagos ultimos 30 dias -->
          <div class="col-12 col-sm-6">
            <div class="p-3 rounded-3 bg-light border border-light-subtle d-flex align-items-center justify-content-between h-100">
              <div>
                <div class="text-muted small fw-bold text-uppercase mb-1">
                  <i class="bi bi-cash-stack text-success me-1"></i> Total Pagos (Últimos 30 Días)
                </div>
                <div class="fs-3 fw-bold text-success mb-1">
                  ${{ total_payments_30_days|number_format(2, '.', ',') }}
                </div>
                <div class="small text-muted">
                  Cobros y anticipos recibidos en el taller
                </div>
              </div>
              <div class="p-3 rounded-circle bg-success bg-opacity-10 text-success d-flex align-items-center justify-content-center">
                <i class="bi bi-wallet2 fs-2"></i>
              </div>
            </div>
          </div>

          <!-- Total saldo pendiente de servicios realizados -->
          <div class="col-12 col-sm-6">
            <div class="p-3 rounded-3 bg-light border border-light-subtle d-flex align-items-center justify-content-between h-100">
              <div>
                <div class="text-muted small fw-bold text-uppercase mb-1">
                  <i class="bi bi-hourglass-split text-danger me-1"></i> Total Saldo Pendiente
                </div>
                <div class="fs-3 fw-bold text-danger mb-1">
                  ${{ total_pending_balance|number_format(2, '.', ',') }}
                </div>
                <div class="small text-muted">
                  <span class="badge bg-danger bg-opacity-10 text-danger border border-danger-subtle">{{ pending_orders_count }} órdenes</span> por liquidar
                </div>
              </div>
              <div class="p-3 rounded-circle bg-danger bg-opacity-10 text-danger d-flex align-items-center justify-content-center">
                <i class="bi bi-exclamation-triangle fs-2"></i>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Gráfica de Pie: Órdenes Pendientes y En Reparación (col-md-3) -->
  <div class="col-12 col-md-3">
    <div class="card border-0 shadow-sm rounded-3 h-100">
      <div class="card-header bg-white py-3 border-bottom">
        <h5 class="mb-0 fw-bold">
          <i class="bi bi-pie-chart-fill me-2" style="color: #15803d;"></i>Órdenes de Servicio
        </h5>
      </div>
      <div class="card-body p-3 d-flex flex-column justify-content-between">
        <!-- Canvas para Pie/Doughnut -->
        <div style="position: relative; height: 210px; width: 100%;">
          <canvas id="ordersPieChart"></canvas>
        </div>

        <!-- Desglose numérico -->
        <div class="mt-3 pt-3 border-top">
          <div class="d-flex justify-content-between align-items-center mb-2 p-2 rounded bg-light">
            <span class="small fw-semibold d-flex align-items-center">
              <span class="d-inline-block rounded-circle me-2" style="width: 12px; height: 12px; background-color: #f59e0b;"></span>
              Pendientes
            </span>
            <span class="badge bg-warning text-dark fw-bold fs-6">{{ orders_pending_count }}</span>
          </div>

          <div class="d-flex justify-content-between align-items-center mb-2 p-2 rounded bg-light">
            <span class="small fw-semibold d-flex align-items-center">
              <span class="d-inline-block rounded-circle me-2" style="width: 12px; height: 12px; background-color: #15803d;"></span>
              En Reparación
            </span>
            <span class="badge fw-bold fs-6" style="background-color: #15803d !important; color: #ffffff !important;">{{ orders_in_repair_count }}</span>
          </div>

          <div class="d-flex justify-content-between align-items-center px-2 pt-2 text-muted small">
            <span>Total en taller:</span>
            <span class="fw-bold text-dark">{{ orders_pending_count + orders_in_repair_count }} órdenes</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Órdenes de Servicio Recientes -->
<div class="card border-0 shadow-sm rounded-3 mb-4">
  <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
    <h5 class="mb-0 fw-bold"><i class="bi bi-clock-history me-2 text-primary"></i>Órdenes de Servicio Recientes</h5>
    <a href="{{ base_url }}/operations" class="btn btn-sm btn-outline-primary fw-bold">Ver Todas</a>
  </div>
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th># Folio</th>
            <th>Equipo</th>
            <th>Cliente</th>
            <th>Estado</th>
            <th>Total</th>
            <th class="text-end">Acciones</th>
          </tr>
        </thead>
        <tbody>
          {% for op in recent_operations %}
            <tr>
              <td><span class="badge bg-secondary">#{{ op.id }}</span></td>
              <td>
                {% if op.getDevice() %}
                  <span class="fw-bold">{{ op.getDevice().brand }} {{ op.getDevice().model }}</span><br>
                  <small class="text-muted">Folio: {{ op.getDevice().plate }}</small>
                {% else %}
                  <span class="text-muted">Sin Dispositivo</span>
                {% endif %}
              </td>
              <td>
                {% if op.getContact() %}
                  {{ op.getContact().name }} {{ op.getContact().lastname }}
                {% else %}
                  <span class="text-muted">-</span>
                {% endif %}
              </td>
              <td>
                {% if op.getStatus() %}
                  <span class="badge" style="background-color: {{ op.getStatus().color }};">{{ op.getStatus().name }}</span>
                {% else %}
                  <span class="badge bg-secondary">Pendiente</span>
                {% endif %}
              </td>
              <td class="fw-bold text-success">${{ op.total|number_format(2, '.', ',') }}</td>
              <td class="text-end">
                <a href="{{ base_url }}/operation/{{ op.id }}" class="btn btn-sm btn-outline-primary" title="Ver Detalle">
                  <i class="bi bi-eye"></i> Detalle
                </a>
              </td>
            </tr>
          {% else %}
            <tr>
              <td colspan="6" class="text-center py-4 text-muted">No hay órdenes de servicio registradas.</td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
</div>
{% endblock %}

{% block scripts %}
<script>
document.addEventListener("DOMContentLoaded", function() {
  // 1. Gráfica de Pagos de los Últimos 30 Días (Verde Oscuro)
  const paymentCanvas = document.getElementById('payments30DaysChart');
  if (paymentCanvas && typeof Chart !== 'undefined') {
    const ctxPayment = paymentCanvas.getContext('2d');
    const paymentGradient = ctxPayment.createLinearGradient(0, 0, 0, 240);
    paymentGradient.addColorStop(0, 'rgba(21, 128, 61, 0.35)');
    paymentGradient.addColorStop(1, 'rgba(21, 128, 61, 0.01)');

    new Chart(ctxPayment, {
      type: 'line',
      data: {
        labels: {{ chart_30days_labels|json_encode|raw }},
        datasets: [{
          label: 'Pagos Recibidos ($)',
          data: {{ chart_30days_values|json_encode|raw }},
          borderColor: '#15803d',
          backgroundColor: paymentGradient,
          fill: true,
          tension: 0.35,
          borderWidth: 3,
          pointBackgroundColor: '#15803d',
          pointBorderColor: '#ffffff',
          pointBorderWidth: 2,
          pointRadius: 4,
          pointHoverRadius: 6,
          pointHoverBackgroundColor: '#16a34a',
          pointHoverBorderColor: '#ffffff'
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        interaction: {
          mode: 'index',
          intersect: false
        },
        plugins: {
          legend: {
            display: false
          },
          tooltip: {
            backgroundColor: 'rgba(15, 23, 42, 0.92)',
            titleFont: { size: 13, weight: 'bold' },
            bodyFont: { size: 13 },
            padding: 10,
            cornerRadius: 8,
            displayColors: false,
            callbacks: {
              label: function(context) {
                let val = context.parsed.y || 0;
                return ' Total Cobrado: $' + val.toLocaleString('es-MX', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
              }
            }
          }
        },
        scales: {
          x: {
            grid: { display: false },
            ticks: {
              maxTicksLimit: 10,
              font: { size: 11 }
            }
          },
          y: {
            beginAtZero: true,
            grid: { color: 'rgba(0, 0, 0, 0.05)' },
            ticks: {
              callback: function(val) {
                return '$' + Number(val).toLocaleString('es-MX');
              },
              font: { size: 11 }
            }
          }
        }
      }
    });
  }

  // 2. Gráfica de Pie: Órdenes Pendientes vs En Reparación (Verde Oscuro)
  const pieCanvas = document.getElementById('ordersPieChart');
  if (pieCanvas && typeof Chart !== 'undefined') {
    const ctxPie = pieCanvas.getContext('2d');
    const pendingVal = {{ orders_pending_count }};
    const inRepairVal = {{ orders_in_repair_count }};
    const totalOrders = pendingVal + inRepairVal;

    new Chart(ctxPie, {
      type: 'doughnut',
      data: {
        labels: ['Pendientes', 'En Reparación'],
        datasets: [{
          data: totalOrders > 0 ? [pendingVal, inRepairVal] : [1, 0],
          backgroundColor: totalOrders > 0 ? ['#f59e0b', '#15803d'] : ['#e2e8f0', '#cbd5e1'],
          borderColor: '#ffffff',
          borderWidth: 3,
          hoverOffset: 6
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        cutout: '66%',
        plugins: {
          legend: {
            position: 'bottom',
            labels: {
              boxWidth: 14,
              padding: 12,
              font: { size: 12, weight: '600' }
            }
          },
          tooltip: {
            backgroundColor: 'rgba(15, 23, 42, 0.92)',
            padding: 10,
            cornerRadius: 8,
            callbacks: {
              label: function(context) {
                if (totalOrders === 0) return ' Sin órdenes en proceso';
                let label = context.label || '';
                let val = context.parsed || 0;
                let pct = totalOrders > 0 ? Math.round((val / totalOrders) * 100) : 0;
                return ' ' + label + ': ' + val + ' (' + pct + '%)';
              }
            }
          }
        }
      }
    });
  }
});
</script>
{% endblock %}


