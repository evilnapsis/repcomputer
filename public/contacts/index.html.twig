{% extends "layouts/main.html.twig" %}

{% block title %}Contactos y Clientes{% endblock %}

{% block content %}
<div class="d-flex align-items-center justify-content-between mb-2">
  <div>
    <h2 class="fw-bold text-dark mb-1">
      Clientes
    </h2>
  </div>
</div>

<div class="d-flex align-items-center justify-content-between mb-4">
  <div>
    <a href="{{ base_url }}/contact/new" class="btn btn-primary fw-bold px-3 shadow-sm">
      <i class="bi bi-person-plus-fill me-2"></i> Nuevo Cliente
    </a>
  </div>
</div>

<div class="card border-0 shadow-sm rounded-3">
  <div class="card-body p-4">
    <div class="table-responsive">
      <table class="table table-bordered table-hover align-middle">
        <thead class="table-light">
          <tr>
            <th>Nombre completo</th>
            <th>Email</th>
            <th>Teléfono</th>
            <th>Estado</th>
            <th class="text-center" style="width: 100px;">Acciones</th>
          </tr>
        </thead>
        <tbody>
          {% for c in contacts %}
            <tr>
              <td><span class="fw-bold">{{ c.name }} {{ c.lastname }}</span></td>
              <td>{{ c.email }}</td>
              <td>{{ c.phone }}</td>
              <td class="text-center">
                {% if c.is_active == 1 %}
                  <span class="badge bg-success shadow-sm">Activo</span>
                {% else %}
                  <span class="badge bg-danger shadow-sm">Inactivo</span>
                {% endif %}
              </td>
              <td class="text-center">
                <a href="{{ base_url }}/contact/{{ c.id }}/edit" class="btn btn-warning btn-sm text-white me-1" title="Editar">
                  <i class="bi bi-pencil-square"></i>
                </a>
                <form action="{{ base_url }}/contact/{{ c.id }}/delete" method="POST" class="d-inline" onsubmit="return confirm('¿Seguro de eliminar este contacto?');">
                  {{ csrf_field() }}
                  <button type="submit" class="btn btn-danger btn-sm" title="Eliminar">
                    <i class="bi bi-trash"></i>
                  </button>
                </form>
              </td>
            </tr>
          {% else %}
            <tr>
              <td colspan="5" class="text-center py-4 text-muted">No hay clientes registrados.</td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
</div>
{% endblock %}
