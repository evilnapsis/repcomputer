{% extends "layouts/main.html.twig" %}

{% block title %}Editar Servicio{% endblock %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h2 class="fw-bold mb-1"><i class="bi bi-pencil-square text-primary me-2"></i>Editar Servicio</h2>
  </div>
  <a href="{{ base_url }}/services" class="btn btn-outline-secondary fw-bold">
    <i class="bi bi-arrow-left me-2"></i> Volver a Servicios
  </a>
</div>

<div class="card border-0 shadow-sm rounded-3">
  <div class="card-body p-4">
    <form action="{{ base_url }}/service/{{ service.id }}/update" method="POST">
      {{ csrf_field() }}
      <div class="row g-3">
        <div class="col-md-6">
          <label class="form-label fw-bold">Nombre del Servicio *</label>
          <input type="text" name="name" class="form-control" value="{{ service.name }}" required>
        </div>
        <div class="col-md-3">
          <label class="form-label fw-bold">Precio Sugerido ($) *</label>
          <input type="number" step="0.01" name="price" class="form-control" value="{{ service.price }}" required>
        </div>
        <div class="col-md-3">
          <label class="form-label fw-bold">Estado *</label>
          <select name="is_active" class="form-select">
            <option value="1" {% if service.is_active == 1 %}selected{% endif %}>Activo</option>
            <option value="0" {% if service.is_active == 0 %}selected{% endif %}>Inactivo</option>
          </select>
        </div>
        <div class="col-md-12">
          <label class="form-label fw-bold">Descripción del Servicio</label>
          <textarea name="description" class="form-control" rows="3">{{ service.description }}</textarea>
        </div>
      </div>

      <div class="mt-4 text-end border-top pt-3">
        <button type="submit" class="btn btn-primary px-4 fw-bold">
          <i class="bi bi-save me-2"></i> Actualizar Servicio
        </button>
      </div>
    </form>
  </div>
</div>
{% endblock %}
