{% extends "layouts/main.html.twig" %}

{% block title %}Nuevo Servicio{% endblock %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h2 class="fw-bold mb-1"><i class="bi bi-tools text-primary me-2"></i>Registrar Nuevo Servicio</h2>
  </div>
  <a href="{{ base_url }}/services" class="btn btn-outline-secondary fw-bold">
    <i class="bi bi-arrow-left me-2"></i> Volver a Servicios
  </a>
</div>

<div class="card border-0 shadow-sm rounded-3">
  <div class="card-body p-4">
    <form action="{{ base_url }}/service/create" method="POST">
      {{ csrf_field() }}
      <div class="row g-3">
        <div class="col-md-8">
          <label class="form-label fw-bold">Nombre del Servicio *</label>
          <input type="text" name="name" class="form-control" placeholder="Ej. Afinación Mayor, Servicio de Frenos" required>
        </div>
        <div class="col-md-4">
          <label class="form-label fw-bold">Precio Base ($) *</label>
          <input type="number" step="0.01" name="price" class="form-control" placeholder="0.00" required>
        </div>
        <div class="col-md-12">
          <label class="form-label fw-bold">Descripción del Servicio</label>
          <textarea name="description" class="form-control" rows="3" placeholder="Detalle de trabajos incluidos en este servicio"></textarea>
        </div>
      </div>

      <div class="mt-4 text-end border-top pt-3">
        <button type="submit" class="btn btn-primary px-4 fw-bold">
          <i class="bi bi-save me-2"></i> Guardar Servicio
        </button>
      </div>
    </form>
  </div>
</div>
{% endblock %}
