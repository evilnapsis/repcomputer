{% extends "layouts/main.html.twig" %}

{% block title %}Reportes de Taller{% endblock %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-3">
  <div>
    <h2 class="fw-bold mb-1"><i class="bi bi-bar-chart-line text-primary me-2"></i>
      {% if opt == 'payments' %}
        Reporte de Ingresos / Pagos
      {% else %}
        Reporte de Órdenes de Servicio
      {% endif %}
    </h2>
  </div>
  {% if (opt == 'payments' and payments|length > 0) or (opt == 'service_orders' and operations|length > 0) %}
    <div>
      <a href="report/reports-pdf.php?opt={{ opt }}&sd={{ sd }}&ed={{ ed }}{% if status_id %}&status_id={{ status_id }}{% endif %}{% if contact_id %}&contact_id={{ contact_id }}{% endif %}{% if method %}&method={{ method }}{% endif %}" target="_blank" class="btn btn-outline-danger fw-bold">
        <i class="bi bi-file-earmark-pdf me-1"></i> Exportar PDF
      </a>
    </div>
  {% endif %}
</div>

<!-- Pestañas de tipo de reporte -->
<ul class="nav nav-tabs mb-4">
  <li class="nav-item">
    <a class="nav-link {% if opt == 'service_orders' %}active fw-bold{% endif %}" href="{{ base_url }}/reports?opt=service_orders"><i class="bi bi-tools me-1"></i>Órdenes de Servicio</a>
  </li>
  <li class="nav-item">
    <a class="nav-link {% if opt == 'payments' %}active fw-bold{% endif %}" href="{{ base_url }}/reports?opt=payments"><i class="bi bi-cash-stack me-1"></i>Ingresos / Pagos</a>
  </li>
</ul>

<!-- Filtros -->
<div class="card border-0 shadow-sm rounded-3 mb-4">
  <div class="card-header bg-dark text-white fw-bold py-3">
    <i class="bi bi-funnel-fill me-2"></i> Filtros del Reporte
  </div>
  <div class="card-body p-4">
    <form action="{{ base_url }}/reports" method="GET">
      <input type="hidden" name="opt" value="{{ opt }}">
      <div class="row g-3 align-items-end">
        <div class="col-md-3">
          <label class="form-label fw-bold">Fecha Desde</label>
          <input type="date" name="sd" class="form-control" value="{{ sd }}">
        </div>
        <div class="col-md-3">
          <label class="form-label fw-bold">Fecha Hasta</label>
          <input type="date" name="ed" class="form-control" value="{{ ed }}">
        </div>

        {% if opt == 'service_orders' %}
          <div class="col-md-3">
            <label class="form-label fw-bold">Estado</label>
            <select name="status_id" class="form-select select2">
              <option value="">-- TODOS --</option>
              {% for st in statuses %}
                <option value="{{ st.id }}" {% if status_id == st.id %}selected{% endif %}>{{ st.name }}</option>
              {% endfor %}
            </select>
          </div>
        {% else %}
          <div class="col-md-3">
            <label class="form-label fw-bold">Forma de Pago</label>
            <select name="method" class="form-select select2">
              <option value="">-- TODAS --</option>
              {% for m in methods %}
                <option value="{{ m }}" {% if method == m %}selected{% endif %}>{{ m }}</option>
              {% endfor %}
            </select>
          </div>
        {% endif %}

        <div class="col-md-3">
          <label class="form-label fw-bold">Cliente</label>
          <select name="contact_id" class="form-select select2">
            <option value="">-- TODOS --</option>
            {% for c in clients %}
              <option value="{{ c.id }}" {% if contact_id == c.id %}selected{% endif %}>{{ c.name }} {{ c.lastname }}</option>
            {% endfor %}
          </select>
        </div>

        <div class="col-md-12 text-end mt-4">
          <button type="submit" class="btn btn-primary fw-bold px-4">
            <i class="bi bi-search me-2"></i> Generar Reporte
          </button>
        </div>
      </div>
    </form>
  </div>
</div>

{% if opt == 'payments' %}

  <!-- INGRESOS: cobros efectivamente registrados en el periodo -->
  <div class="card border-0 shadow-sm rounded-3">
    <div class="card-body">
      <div class="table-responsive">
        <table class="table table-hover align-middle">
          <thead class="table-light">
            <tr>
              <th>Fecha</th>
              <th>Orden</th>
              <th>Cliente</th>
              <th>Forma de Pago</th>
              <th>Referencia</th>
              <th class="text-end">Monto ($)</th>
            </tr>
          </thead>
          <tbody>
            {% set totalCobrado = 0 %}
            {% for pay in payments %}
              {% set totalCobrado = totalCobrado + pay.amount %}
              {% set payContact = pay.getContact() %}
              <tr>
                <td><small class="text-muted">{{ pay.created_at|date("d/m/Y H:i") }}</small></td>
                <td><a href="{{ base_url }}/operation/{{ pay.operation_id }}" class="badge bg-secondary text-decoration-none">#{{ "%05d"|format(pay.operation_id) }}</a></td>
                <td>{{ payContact ? payContact.name ~ " " ~ payContact.lastname : 'Sin cliente' }}</td>
                <td><span class="badge bg-dark">{{ pay.method }}</span></td>
                <td>
                  {% if pay.reference %}
                    <small>{{ pay.reference }}</small>
                  {% else %}
                    <small class="text-muted">-</small>
                  {% endif %}
                </td>
                <td class="text-end fw-bold text-success">${{ pay.amount|number_format(2, '.', ',') }}</td>
              </tr>
            {% else %}
              <tr>
                <td colspan="6" class="text-center py-4 text-muted">No se registraron cobros en el periodo seleccionado.</td>
              </tr>
            {% endfor %}
          </tbody>
          {% if payments|length > 0 %}
            <tfoot class="table-light fw-bold">
              <tr>
                <td colspan="5" class="text-end">TOTAL COBRADO:</td>
                <td class="text-end text-success fs-5">${{ totalCobrado|number_format(2, '.', ',') }}</td>
              </tr>
            </tfoot>
          {% endif %}
        </table>
      </div>
    </div>
  </div>

{% else %}

  <!-- ÓRDENES DE SERVICIO: valor facturado, cobrado y saldo -->
  <div class="card border-0 shadow-sm rounded-3">
    <div class="card-body">
      <div class="table-responsive">
        <table class="table table-hover align-middle">
          <thead class="table-light">
            <tr>
              <th>Folio</th>
              <th>Equipo</th>
              <th>Cliente</th>
              <th>Estado</th>
              <th>Fecha</th>
              <th class="text-end">Total ($)</th>
              <th class="text-end">Cobrado ($)</th>
              <th class="text-end">Saldo ($)</th>
            </tr>
          </thead>
          <tbody>
            {% set totalSum = 0 %}
            {% set paidSum = 0 %}
            {% set balanceSum = 0 %}
            {% for op in operations %}
              {% set paid = paid_map[op.id]|default(0) %}
              {% set balance = op.total - paid %}
              {% if balance < 0 %}{% set balance = 0 %}{% endif %}
              {% set totalSum = totalSum + op.total %}
              {% set paidSum = paidSum + paid %}
              {% set balanceSum = balanceSum + balance %}
              <tr>
                <td><a href="{{ base_url }}/operation/{{ op.id }}" class="badge bg-secondary text-decoration-none">#{{ op.id }}</a></td>
                <td>
                  {% if op.getDevice() %}
                    <span class="fw-bold">{{ op.getDevice().brand }} {{ op.getDevice().model }}</span> ({{ op.getDevice().plate }})
                  {% else %}
                    <span class="text-muted">-</span>
                  {% endif %}
                </td>
                <td>
                  {% if op.getContact() %}
                    {{ op.getContact().name }} {{ op.getContact().lastname }}
                  {% else %}
                    <span class="text-muted">-</span>
                  {% endif %}
                </td>
                <td>
                  {% if op.getStatus() %}
                    <span class="badge" style="background-color: {{ op.getStatus().color }};">{{ op.getStatus().name }}</span>
                  {% else %}
                    <span class="badge bg-secondary">-</span>
                  {% endif %}
                </td>
                <td><small class="text-muted">{{ op.created_at|date("d/m/Y") }}</small></td>
                <td class="text-end fw-bold">${{ op.total|number_format(2, '.', ',') }}</td>
                <td class="text-end text-success">${{ paid|number_format(2, '.', ',') }}</td>
                <td class="text-end fw-bold {% if balance > 0 %}text-danger{% else %}text-muted{% endif %}">${{ balance|number_format(2, '.', ',') }}</td>
              </tr>
            {% else %}
              <tr>
                <td colspan="8" class="text-center py-4 text-muted">No hay resultados para los filtros seleccionados.</td>
              </tr>
            {% endfor %}
          </tbody>
          {% if operations|length > 0 %}
            <tfoot class="table-light fw-bold">
              <tr>
                <td colspan="5" class="text-end">TOTALES:</td>
                <td class="text-end fs-6">${{ totalSum|number_format(2, '.', ',') }}</td>
                <td class="text-end text-success fs-6">${{ paidSum|number_format(2, '.', ',') }}</td>
                <td class="text-end text-danger fs-6">${{ balanceSum|number_format(2, '.', ',') }}</td>
              </tr>
            </tfoot>
          {% endif %}
        </table>
      </div>
    </div>
  </div>

{% endif %}
{% endblock %}
