{% extends "layouts/main.html.twig" %}

{% block title %}Editar Tipo de Dispositivo{% endblock %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-3">
  <div>
    <h2 class="fw-bold text-dark mb-1">Editar Tipo de Dispositivo</h2>
    <div class="text-muted small">Modifique el nombre, descripción o visibilidad de este tipo de equipo</div>
  </div>
  <a href="{{ base_url }}/device-types" class="btn btn-outline-secondary fw-bold">
    <i class="bi bi-arrow-left me-1"></i> Volver a la Lista
  </a>
</div>

<div class="card border-0 shadow-sm rounded-3 col-md-8 mx-auto">
  <div class="card-body p-4">
    <form action="{{ base_url }}/device-type/{{ device_type.id }}/update" method="POST">
      {{ csrf_field() }}

      <div class="row g-3">
        <div class="col-md-12">
          <label class="form-label fw-bold">Nombre del Tipo de Dispositivo *</label>
          <input type="text" name="name" class="form-control" value="{{ device_type.name }}" required autofocus>
        </div>

        <div class="col-md-12">
          <label class="form-label fw-bold">Descripción / Alcance</label>
          <textarea name="description" class="form-control" rows="3">{{ device_type.description }}</textarea>
        </div>

        <div class="col-md-6">
          <label class="form-label fw-bold">Estado en el Sistema</label>
          <select name="is_active" class="form-select">
            <option value="1" {% if device_type.is_active == 1 %}selected{% endif %}>Activo (Disponible al registrar equipos)</option>
            <option value="0" {% if device_type.is_active == 0 %}selected{% endif %}>Inactivo (Ocultar temporalmente)</option>
          </select>
        </div>
      </div>

      <div class="mt-4 text-end border-top pt-3">
        <a href="{{ base_url }}/device-types" class="btn btn-light border me-2">Cancelar</a>
        <button type="submit" class="btn btn-primary px-4 fw-bold">
          <i class="bi bi-save me-2"></i> Guardar Cambios
        </button>
      </div>
    </form>
  </div>
</div>
{% endblock %}
